    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "lucide-react": "1.51.0",
    "open": "11.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
