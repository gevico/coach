{
  "name": "coach-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render Markdown as an interactive column canvas.",
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "bin": { "coach": "bin/coach.mjs" },
  "files": ["bin", "dist", "LICENSE", "README.md", "docs/cli.md"],
